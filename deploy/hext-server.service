[Unit]
Description=Hext Remote server (IDs, presence, signaling)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=hext
# To read /etc/hext/relay-livre.txt (root:hext, 640): install.sh creates
# the group.
SupplementaryGroups=hext
EnvironmentFile=/etc/hext/secrets.env
# The SMTP login for the account e-mails (only this service reads it).
EnvironmentFile=-/etc/hext/mail.env
# The relay without the limit (HEXT_RELAY_FULL_URL), if install.sh set it up.
EnvironmentFile=-/etc/hext/relay-full.env
ExecStart=/usr/local/bin/hext-server --listen 127.0.0.1:8080 --db /var/lib/hext/hext-server.db --behind-proxy
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
