# Copie para .env e preencha. O .env fica só no servidor (não vai para o git).

# O seu domínio: signal.<domínio> e relay.<domínio> devem apontar para este servidor.
HEXT_DOMAIN=exemplo.com.br

# Segredo que o relay apresenta ao servidor. Gere com: openssl rand -hex 32
HEXT_RELAY_TOKEN=

# E-mails da conta. Sem isso, nenhum e-mail é enviado e ninguém consegue criar conta.
# HEXT_SMTP_HOST=smtp.exemplo.com.br
# (A porta: deixe a linha comentada, para 587, ou com um número; vazia, o servidor não sobe.)
# HEXT_SMTP_PORT=587
# HEXT_SMTP_USER=
# HEXT_SMTP_PASSWORD=
# HEXT_MAIL_FROM=Hext Remote <nao-responda@exemplo.com.br>
