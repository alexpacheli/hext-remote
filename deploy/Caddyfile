# Caddy in front of the Hext Remote services: TLS (Let's Encrypt, automatic)
# on 443 for both names, everything else private.
#
# {$SIGNAL_HOST} and {$RELAY_HOST} are the two names (signal.<domain> and
# relay.<domain>): install.sh writes them in; with Docker, Caddy reads them
# from the environment. The upstreams are this machine's ports unless the
# environment says otherwise (Docker: the containers).

{
	# Let's Encrypt only (no fallback to another CA): iroh-relay reads the
	# certificate from this CA's folder (see iroh-relay.toml).
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$SIGNAL_HOST} {
	# The relays' access checks are for the relays on this machine only.
	respond /v1/relay-access* 404
	reverse_proxy {$SIGNAL_UPSTREAM:127.0.0.1:8080}
}

{$RELAY_HOST} {
	reverse_proxy {$RELAY_UPSTREAM:127.0.0.1:3340}
}

# Plain HTTP to the relay too, not a redirect: iroh's captive-portal probe
# (http://relay…/generate_204) expects the relay's own answer.
http://{$RELAY_HOST} {
	reverse_proxy {$RELAY_UPSTREAM:127.0.0.1:3340}
}

# The relay without the per-device limit, when install.sh sets it up
# (relay-full.caddy); without it, nothing matches and nothing changes.
import /etc/caddy/hext-*.caddy
